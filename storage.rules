rules_version = '2';

// Arquivos organizados por empresa: /empresas/{id}/fiscal/... (NF-e) e /empresas/{id}/nfse/...
//
// O cliente NÃO acessa o Storage: os XMLs e os PDFs saem pelas callables xmlNotaFiscal,
// xmlNotaServico e pdfNotaServico, que conferem o vínculo do usuário com a empresa e ainda
// registram na auditoria quem baixou o quê. A gravação é do backend, pelo Admin SDK, que não
// passa por estas regras.
//
// Esta é também a razão de não existir mais custom claim de empresa no token: num escritório de
// contabilidade um usuário administra muitas empresas, e a lista não caberia na claim.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
