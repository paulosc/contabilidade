# Parâmetros do backend (defineString / defineInt em functions/src/lib/config.ts).
# Copie para functions/.env. Este arquivo NÃO leva segredo nenhum: a chave que cifra os
# certificados vai para o Secret Manager.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   firebase functions:secrets:set FISCAL_CRYPTO_KEY

# Ambiente sugerido ao cadastrar o certificado: homologacao | producao
# (cada empresa escolhe o seu na tela de Configurações).
SEFAZ_AMBIENTE=homologacao
# Quantas empresas uma execução do worker agendado processa.
FISCAL_MAX_EMPRESAS=10
# Quantos lotes (até 50 documentos cada) uma sincronização busca antes de parar e retomar depois.
FISCAL_MAX_LOTES=20
