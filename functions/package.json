{
  "name": "contabilidade-functions",
  "version": "0.1.0",
  "private": true,
  "description": "Backend (Cloud Functions) do sistema de contabilidade",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "npm run build && node --test \"lib/fiscal/testes/*.test.js\"",
    "test:regras": "npm run build && firebase emulators:exec --only firestore \"node --test lib/fiscal/testes/regras.emulador.js\""
  },
  "dependencies": {
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.4.0",
    "node-forge": "^1.3.1",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^22.10.0",
    "@types/node-forge": "^1.3.14",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.7.3"
  }
}
